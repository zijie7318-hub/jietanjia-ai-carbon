# ============================================================
# 节碳家 · 环境变量模板
# 复制到 backend/.env 后再填写：cp .env.example backend/.env
# 真实密钥只放服务端环境变量，不要提交到仓库。
# ============================================================

# --- 访问分享码（可选）---------------------------------------
# 留空 = 由部署平台入口负责访问控制；填写后要求请求携带 sharecode。
JTC_SHARE_CODE=
JTC_SHARE_CODES=

# --- 接口基础保护（可选）-------------------------------------
JTC_RATE_LIMIT=40
JTC_RATE_WINDOW=300
# 仅当应用确实位于可信反向代理后方时开启，避免伪造 X-Forwarded-For。
JTC_TRUST_PROXY=0
# 同源部署无需 CORS；仅本机跨端口调试时设为 1。
JTC_ENABLE_CORS=0

# --- 用户数据 -------------------------------------------------
# SQLite 路径；生产环境必须放到持久化磁盘。
HT_DB_PATH=
# 登录令牌签名密钥。生产环境必须独立配置高熵值（建议 32 字符以上）；
# 留空时仅使用进程级随机密钥，服务重启后登录态会失效。
HT_TOKEN_SECRET=

# --- 部署 -----------------------------------------------------
PORT=5000
# 仅排查部署问题时临时开启 /api/debug/auth，平时保持关闭。
HT_DEBUG=0

# 大模型采用用户 BYOK，通过前端配置并只随请求头传递，
# 服务端不保存模型 Key，因此这里不提供 LLM Key 配置项。
# 默认只允许内置模型预设地址。如需自建 OpenAI 兼容服务，在此显式加入
# 完整 base_url，英文逗号分隔；不要填写可访问内网的任意地址。
JTC_LLM_ALLOWED_BASE_URLS=
